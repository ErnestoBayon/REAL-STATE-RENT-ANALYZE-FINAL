# Streamlit Secrets Template
# For local development: Copy this to .streamlit/secrets.toml and fill in your API keys
# For Streamlit Cloud: Add these keys in the App Settings > Secrets section

# Census Bureau API Key
# Get your key at: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY = "your_census_api_key_here"

# Federal Reserve FRED API Key  
# Get your key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY = "your_fred_api_key_here"
